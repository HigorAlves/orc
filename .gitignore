.DS_Store

# orc workspace state — ephemeral, per-session checkpoints. Never commit.
.orc/

# Curation source directories — kept locally during dev, archived pre-publish
# (per the plan). Never commit; the plugin loader doesn't read them.
skills-database/
skills-old/

# Graphify code-graph output — regenerated locally from source (orc:code-discovery).
# Never commit; it's a derived artifact, not source.
graphify-out/

# Machine-local Claude Code settings (per-user permissions/paths). Portable
# guard so contributors without a global rule don't commit their own.
.claude/settings.local.json

# claude plugin eval run output
orc/evals/results/

# Claude Code regenerates the mod type declarations per installed version
orc/.claude-plugin/types/
