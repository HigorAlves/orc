#!/usr/bin/env bash
# orc-stage — factory stage packs CLI (plugin bin/, on PATH while orc is
# enabled). Wraps lib/stage.sh: list packs, validate stage input/output
# against the contract schemas, render a stage prompt from a pack.
# Contract schemas: orc/factory/schema/*.json.
set -euo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck disable=SC1091
. "${dir}/../lib/stage.sh"

usage() {
  cat <<'EOF2'
usage: orc-stage <verb> [args]   (packs: $ORC_FACTORY_STAGES, else factory/stages.json)

  packs                                  one line per pack: id, agent|script, writable, tools
  validate --input <file>                stage input against the contract (exit 0 | 1 key named | 2 usage)
  validate --output <file>               stage output against the contract
  validate --packs                       the packs file against its schema
  render <pack> <stage.json>             print the stage prompt (header, output schema, template)
  run --in F --out D [--plugin-root P] [--dry-run]   run the stage via the Agent SDK (--dry-run prints options)
EOF2
}

sub="${1:-}"
if [ -z "$sub" ]; then usage >&2; exit 2; fi
shift

case "$sub" in
  packs)    orc_stage_packs "$@" ;;
  validate) orc_stage_validate "$@" ;;
  render)   orc_stage_render "$@" ;;
  run)      orc_stage_run "$@" ;;
  -h|--help|help) usage ;;
  *) echo "orc-stage: unknown verb '$sub'" >&2; usage >&2; exit 2 ;;
esac
