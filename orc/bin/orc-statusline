#!/usr/bin/env bash
# orc-statusline — Claude Code statusLine renderer (plugin bin/, on PATH
# while orc is enabled; also invoked directly by the statusLine setting).
# Reads the documented JSON payload on stdin, prints the two-line orc
# status. Contract: never fails — every path exits 0; a broken install
# prints a one-line self-diagnosis instead of dying.
set -uo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck disable=SC1091
. "${dir}/../lib/state.sh" 2>/dev/null || true
# shellcheck disable=SC1091
. "${dir}/../lib/statusline.sh" 2>/dev/null || true

# stdin guard: the payload arrives as one JSON doc; never hang on a broken
# pipe (documented Windows/Git-Bash hazard) — 3s cap, then render best-effort.
payload=""
IFS= read -r -d '' -t 3 payload || true

if ! type orc_statusline_render >/dev/null 2>&1; then
  echo "orc statusline: plugin files inconsistent — reinstall orc"
  exit 0
fi

orc_statusline_render "$payload" 2>/dev/null || true
exit 0
