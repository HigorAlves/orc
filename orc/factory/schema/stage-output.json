{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orc.dev/factory/stage-output.json",
  "title": "StageOutput",
  "type": "object",
  "required": [
    "schema",
    "ok",
    "outcome",
    "summary",
    "needsInput",
    "requested",
    "findings",
    "artifacts",
    "slices",
    "commit",
    "usage",
    "error",
    "rateLimited",
    "resetsAt"
  ],
  "properties": {
    "schema": {
      "enum": [
        1,
        2
      ],
      "description": "2 adds the escalated outcome; a controller reads both."
    },
    "ok": {
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "needs_input",
        "test_change",
        "escalated"
      ],
      "description": "escalated (schema 2 only): the agent stopped on purpose; answer.reason says why, answer.options lists the ways on."
    },
    "summary": {
      "type": "string"
    },
    "needsInput": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "question",
          "recommended"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "recommended": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "requested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "target",
          "payload"
        ],
        "properties": {
          "kind": {
            "enum": [
              "tracker_write",
              "pr_review_post",
              "publish"
            ]
          },
          "target": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "line",
          "severity",
          "title",
          "body",
          "confidence"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "severity": {
            "enum": [
              "bug",
              "security",
              "api-surface",
              "test",
              "nit",
              "suggestion",
              "question"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "label",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "qa-manifest",
              "screenshot",
              "video",
              "har",
              "report",
              "test",
              "diff",
              "findings",
              "rules"
            ]
          },
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "slices": {
      "type": "object",
      "required": [
        "done",
        "total"
      ],
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "type": "object",
      "required": [
        "turns",
        "costUsd",
        "durationMs",
        "model"
      ],
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "rateLimited": {
      "type": "boolean"
    },
    "resetsAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "answer": {
      "type": [
        "object",
        "null"
      ],
      "description": "The pack-specific structured answer, verbatim (optional, additive)."
    }
  }
}
